# ProxyVeto Environment Variables
# Copy to .env and fill in your values

# Required: OpenCode Zen JEV API key (get from https://opencode.ai)
OPENCODE_API_KEY=your-api-key-here

# Optional: Override default JEV endpoint
# OPENCODE_BASE_URL=https://api.opencode.ai/v1

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO